# Copy to .env.prod (in the repository root; it's gitignored) and fill in.
# Used by docker-compose.prod.yml, both for the containers' environment and
# for Compose's own settings. Don't put quotes around values.

# Which optional parts to run; see the top of docker-compose.prod.yml.
COMPOSE_PROFILES=bundled-db,caddy

# --- Compose settings ---
# Public hostname (caddy profile).
HERRING_DOMAIN=herring.example.com
# Where the web container listens on the host. Behind Caddy, keep it on
# localhost; behind an AWS load balancer, use e.g. 0.0.0.0:8000.
#HERRING_WEB_PORT=127.0.0.1:8000
#WEB_CONCURRENCY=4

# --- Bundled Postgres (bundled-db profile) ---
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://herring:change-me@postgres/herring
REDIS_URL=redis://redis:6379/0
# For RDS / ElastiCache instead, drop bundled-db from COMPOSE_PROFILES and use e.g.:
#DATABASE_URL=postgres://herring:PASSWORD@mydb.xxxxxxxx.us-east-1.rds.amazonaws.com:5432/herring?sslmode=require
#REDIS_URL=rediss://master.mycache.xxxxxx.use1.cache.amazonaws.com:6379/0

# --- Herring settings (same as on Heroku; see .env.example) ---
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(50))'
SECRET_KEY=
HOST=https://herring.example.com/
TEAM_NAME=Non-Abelian Rage Theory
HUNT_ID=0
ACTIVATE_DISCORD=0
ACTIVATE_GAPPS=0
#DISCORD_GUILD=...
#SECRETS={"gapps-folder":"...","gapps-doc-to-clone":"...","discord-bot-token":"...","magic-secret":"..."}
#FUCK_OAUTH={...service account JSON...}
